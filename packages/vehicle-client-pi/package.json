{
	"name": "@danypops/vehicle-client-pi",
	"version": "0.3.0",
	"description": "Projects any VehicleClient's manifest into native Pi tools, plus the rest of this house's Pi-extension-facing surface: jiti-load-safety verification and the shared /secrets command (backend port, env/local implementations, cross-extension registry, TUI). Preserves operation versions, schemas, cancellation, Pi call/session identity, permissions, keyed idempotency, progress, and structured failures; curates tool visibility by live operation availability.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/vehicle-pi.js",
	"types": "./dist/vehicle-pi.d.ts",
	"exports": {
		".": {
			"types": "./dist/vehicle-pi.d.ts",
			"default": "./dist/vehicle-pi.js"
		},
		"./pi-load-harness": "./src/pi-load-harness.ts",
		"./secrets-backend": "./src/secrets-backend.ts",
		"./secrets-backend-env": "./src/secrets-backend-env.ts",
		"./secrets-backend-local": "./src/secrets-backend-local.ts",
		"./secrets-registry": "./src/secrets-registry.ts",
		"./secrets-tui": "./src/secrets-tui.ts"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "bun run build && bun test test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@danypops/vehicle-core": "workspace:*",
		"@danypops/vehicle-server": "workspace:*",
		"malevich-tui-components": "^0.16.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "latest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/vehicle.git",
		"directory": "packages/vehicle-client-pi"
	},
	"keywords": ["vehicle", "agent-tools", "pi-extension"],
	"files": ["src", "dist", "README.md"]
}
