{
	"name": "@danypops/vehicle-client-pi",
	"version": "0.16.2",
	"description": "Projects any VehicleClient's manifest into native Pi tools, plus the rest of this house's Pi-extension-facing surface: jiti-load-safety verification and the shared /secrets command (backend port, env/local implementations, cross-extension registry, TUI). Preserves operation versions, schemas, cancellation, Pi call/session identity, permissions, keyed idempotency, progress, and structured failures; curates tool visibility by live operation availability.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/vehicle-pi.js",
	"types": "./dist/vehicle-pi.d.ts",
	"exports": {
		".": {
			"types": "./dist/vehicle-pi.d.ts",
			"default": "./dist/vehicle-pi.js"
		},
		"./activity-broker": {
			"types": "./dist/activity-broker.d.ts",
			"default": "./dist/activity-broker.js"
		},
		"./pi-load-harness": "./src/pi-load-harness.ts",
		"./pi-status-refresh": "./src/pi-status-refresh.ts",
		"./secrets-backend": "./src/secrets-backend.ts",
		"./secrets-backend-env": "./src/secrets-backend-env.ts",
		"./secrets-backend-local": "./src/secrets-backend-local.ts",
		"./secrets-registry": "./src/secrets-registry.ts",
		"./secrets-tui": "./src/secrets-tui.ts",
		"./vehicle-render": {
			"types": "./dist/vehicle-render.d.ts",
			"default": "./dist/vehicle-render.js"
		},
		"./vehicle-safety": {
			"types": "./dist/vehicle-safety.d.ts",
			"default": "./dist/vehicle-safety.js"
		},
		"./vehicle-safety-registry": {
			"types": "./dist/vehicle-safety-registry.d.ts",
			"default": "./dist/vehicle-safety-registry.js"
		},
		"./safety-command": "./src/vehicle-safety-command.ts",
		"./watched-refresh": "./src/vehicle-watched-refresh.ts",
		"./monolith": {
			"types": "./dist/vehicle-monolith.d.ts",
			"default": "./dist/vehicle-monolith.js"
		},
		"./multi-select-list": {
			"types": "./dist/multi-select-list.d.ts",
			"default": "./dist/multi-select-list.js"
		},
		"./widget-state": {
			"types": "./dist/vehicle-widget-state.d.ts",
			"default": "./dist/vehicle-widget-state.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "bun run build && bun test test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@danypops/vehicle-client": "workspace:*",
		"@danypops/vehicle-core": "workspace:*",
		"@danypops/vehicle-server": "workspace:*",
		"malevich-tui-components": "^0.20.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@danypops/pi-extension-harness": "^0.4.0",
		"@danypops/pi-tui-harness": "^0.0.2",
		"@types/node": "^22.0.0",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/vehicle.git",
		"directory": "packages/vehicle-client-pi"
	},
	"keywords": ["vehicle", "agent-tools", "pi-extension"],
	"files": ["src", "dist", "README.md"]
}
