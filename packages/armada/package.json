{
  "name": "@danypops/armada",
  "version": "0.3.1",
  "description": "Cross-platform desired-state control for local Vehicle fleets",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "armada": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/vehicle.git",
    "directory": "packages/armada"
  },
  "homepage": "https://github.com/DanyPops/vehicle/tree/main/packages/armada#readme",
  "bugs": {
    "url": "https://github.com/DanyPops/vehicle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test test",
    "check": "bun run build && bun run typecheck && bun run test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
