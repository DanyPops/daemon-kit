{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"types": ["node", "bun-types"],
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"outDir": "dist",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src"
	},
	"include": ["src/daemon.ts", "src/paths.ts", "src/http.ts", "src/logging.ts", "src/push-channel.ts", "src/unix-peer-cred.ts", "src/unix-rpc-server.ts"]
}
