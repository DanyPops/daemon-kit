{
	"name": "@danypops/daemon-kit",
	"version": "0.9.0",
	"description": "Shared substrate for supervised, authenticated, loopback-only Bun daemons: process lifecycle, SQLite storage bootstrap, structured logging, and an HTTP auth/RPC layer",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./paths": "./src/paths.ts",
		"./storage": "./src/storage.ts",
		"./logging": "./src/logging.ts",
		"./http": "./src/http.ts",
		"./session-identity": "./src/session-identity.ts",
		"./daemon": "./src/daemon.ts",
		"./rpc-client": "./src/rpc-client.ts",
		"./version": "./src/version.ts",
		"./vault": "./src/vault.ts",
		"./supervisor": "./src/supervisor.ts",
		"./service": "./src/service.ts",
		"./push-channel": "./src/push-channel.ts",
		"./vehicle-conformance": "./src/vehicle-conformance.ts",
		"./pi-load-harness": "./src/pi-load-harness.ts",
		"./pi-client": {
			"types": "./dist/pi-client.d.ts",
			"default": "./dist/pi-client.js"
		},
		"./vehicle": {
			"types": "./dist/vehicle.d.ts",
			"default": "./dist/vehicle.js"
		},
		"./vehicle-pi": {
			"types": "./dist/vehicle-pi.d.ts",
			"default": "./dist/vehicle-pi.js"
		}
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"build:pi-client": "tsc -p tsconfig.pi-client.json",
		"build:vehicle": "tsc -p tsconfig.vehicle.json",
		"build:vehicle-pi": "tsc -p tsconfig.vehicle-pi.json",
		"build": "bun run build:pi-client && bun run build:vehicle && bun run build:vehicle-pi"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typescript": "^5"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"dependencies": {
		"pino": "^10.3.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@types/bun": "latest",
		"@types/node": "^22.0.0",
		"env-paths": "^4",
		"jiti": "^2.0.0",
		"typebox": "1.1.38"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/daemon-kit.git"
	},
	"files": ["src", "dist", "README.md"]
}
