{
	"name": "vehicle-workspace",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "bun run --cwd packages/vehicle-core build && bun run --cwd packages/vehicle-server build && bun run --cwd packages/vehicle-client build && bun run --cwd packages/vehicle-client-pi build",
		"test": "bun run build && bun test packages/*/test scripts/test",
		"typecheck": "for p in packages/*/; do (cd \"$p\" && bunx tsc --noEmit) || exit 1; done",
		"format": "biome format --write .",
		"lint": "biome lint . && eslint packages --max-warnings 0",
		"check": "biome check --write . && eslint packages --max-warnings 0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@danypops/vehicle-client": "workspace:*",
		"@danypops/vehicle-client-pi": "workspace:*",
		"@danypops/vehicle-conformance": "workspace:*",
		"@danypops/vehicle-core": "workspace:*",
		"@danypops/vehicle-server": "workspace:*",
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^22.0.0",
		"bun-types": "latest",
		"env-paths": "^4",
		"eslint": "^10.8.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"jiti": "^2.0.0",
		"typebox": "1.1.38",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.65.0"
	}
}
