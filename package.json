{
  "name": "@danypops/armada",
  "version": "0.1.0",
  "description": "Cross-platform desired-state control for local Vehicle fleets",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "armada": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanyPops/armada.git"
  },
  "homepage": "https://github.com/DanyPops/armada#readme",
  "bugs": {
    "url": "https://github.com/DanyPops/armada/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
